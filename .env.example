# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"

# TypeSafe AI Jev API (Optional, will use deterministic fallback when unset)
TYPESAFE_API_KEY="your-typesafe-api-key"

# Server Configuration
SERVER_PORT=3001
API_URL="http://localhost:3001"

# Database Configuration (SQLite local database file)
DATABASE_URL="./data/resume-ai.sqlite"

# Browser Automation Configuration
# When set to false or omitted, the browser window opens visibly for human observation
BROWSER_HEADLESS=false

# Node Environment
NODE_ENV="development"

# PDF Generation Configuration
# Supported providers: "typst" (default), "react-pdf", "latex" (deprecated legacy)
PDF_PROVIDER="typst"

# Path to Typst binary (Optional if installed globally and available in PATH)
# TYPST_PATH="C:\Program Files\Typst\typst.exe"
