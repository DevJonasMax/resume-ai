{
  "name": "@resume-ai/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "job-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "@resume-ai/applications": "workspace:*",
    "@resume-ai/browser": "workspace:*",
    "@resume-ai/config": "workspace:*",
    "@resume-ai/database": "workspace:*",
    "@resume-ai/jobs": "workspace:*",
    "@resume-ai/resume": "workspace:*",
    "@resume-ai/types": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "rimraf": "^6.0.1"
  }
}
